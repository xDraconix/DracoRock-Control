#!/usr/bin/env bash
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
ACTION="${1:-}"; ID="${2:-}"
[[ "$ACTION" =~ ^(start|stop|restart)$ && "$ID" =~ ^[a-f0-9]{32}$ ]] || exit 2
DIR=/run/bedrock-panel-jobs; FILE="$DIR/$ID.json"
STARTED_AT="$(date +%s)"
write_status() {
  local state="$1" message="$2" rc="$3" tmp
  tmp="$(mktemp "$DIR/.job.XXXXXXXX")"
  # Fixed strings only; no untrusted output inserted into JSON.
  printf '{"id":"%s","action":"%s","state":"%s","message":"%s","exit_status":%s,"started_at":%s,"updated_at":%s,"invocation":"%s"}\n' "$ID" "$ACTION" "$state" "$message" "$rc" "$STARTED_AT" "$(date +%s)" "${INVOCATION_ID:-}" > "$tmp"
  chown root:www-data "$tmp"; chmod 0640 "$tmp"; mv -f "$tmp" "$FILE"
  if [[ "$state" == success || "$state" == failed ]]; then
    install -d -m 0750 -o root -g www-data /var/lib/bedrock-control-pro/jobs
    history_tmp="$(mktemp /var/lib/bedrock-control-pro/jobs/.status.XXXXXXXX)"
    install -m 0640 -o root -g www-data "$FILE" "$history_tmp"
    mv -f "$history_tmp" "/var/lib/bedrock-control-pro/jobs/$ID.json"
    find /var/lib/bedrock-control-pro/jobs -maxdepth 1 -type f -name '*.json' -printf '%T@ %p\n' | sort -nr | tail -n +101 | cut -d' ' -f2- | xargs -r rm --
  fi
}
finish() {
  local rc=$?
  trap - EXIT
  if ((rc==0)); then write_status success 'Serveraktion erfolgreich abgeschlossen.' 0
  else write_status failed 'Serveraktion fehlgeschlagen. Minecraft-Protokoll pruefen.' "$rc"; fi
}
trap finish EXIT
write_status running 'Systemd-Auftrag gestartet; warte auf Abschluss.' null
# A blocking systemctl returns failure for the FIRST failed start, even when
# Restart=on-failure has scheduled another attempt. Observe the unit instead.
if [[ "$ACTION" != stop ]]; then
  # An explicit user action gets a fresh retry budget. Automatic retries remain
  # bounded by StartLimitBurst, so a broken server cannot restart endlessly.
  systemctl reset-failed mcbedrock.service
fi
previous_invocation="$(systemctl show mcbedrock.service -p InvocationID --value)"
systemctl --no-block "$ACTION" mcbedrock.service
start_time=$SECONDS
terminal_since=-1
while ((SECONDS-start_time < 900)); do
  state="$(systemctl show mcbedrock.service -p ActiveState --value)"
  sub="$(systemctl show mcbedrock.service -p SubState --value)"
  if [[ "$ACTION" == stop ]]; then
    if [[ "$state" == inactive || "$state" == failed ]]; then
      [[ "$(systemctl show mcbedrock.service -p MainPID --value)" == 0 ]] && exit 0
    fi
    write_status running 'Minecraft wird kontrolliert gestoppt (STOP-Frist 60 Sekunden).' null
  else
    # active is reached only AFTER the configured ExecStartPost readiness check.
    if [[ "$state" == active && "$sub" == running ]]; then
      current_invocation="$(systemctl show mcbedrock.service -p InvocationID --value)"
      if [[ "$ACTION" != restart || "$current_invocation" != "$previous_invocation" ]]; then
        exit 0
      fi
    fi
    if [[ "$state" == failed || "$state" == inactive ]]; then
      ((terminal_since >= 0)) || terminal_since=$SECONDS
      if ((SECONDS-terminal_since >= 10)); then
        systemctl status mcbedrock.service --no-pager >&2 || true
        exit 1
      fi
    else
      terminal_since=-1
    fi
    write_status running 'Minecraft startet; Portfreigabe, NetherNet-Pruefung und automatische Wiederholungen laufen.' null
  fi
  sleep 2
done
echo 'Zeitlimit der Statusueberwachung erreicht; systemd-Protokoll pruefen.' >&2
exit 1
