#!/usr/bin/env python3
"""Create and verify offline Minecraft backups and retain calendar snapshots."""
import argparse
import contextlib
import ctypes
from datetime import datetime
import fcntl
import hashlib
import json
import os
import pwd
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid
from zipfile import BadZipFile, ZipFile, ZIP_DEFLATED
from zoneinfo import ZoneInfo

SERVER = Path("/home/mcserver/minecraft_bedrock")
BACKUPS = Path("/home/mcserver/backups")
LOCK = Path("/var/lib/bedrock-control-pro/dracorock-backup.lock")
ZONE = ZoneInfo("Europe/Berlin")
WORLD_STAMP = re.compile(r"-(\d{4}-\d{2}-\d{2}T\d{6}[+-]\d{4})-[a-f0-9]{8}\.zip\Z")
NAME_RE = re.compile(r"minecraft-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}\.tar\.gz\Z")
MAX_FILES = 100000
MAX_BYTES = 64 * 1024 ** 3


class BackupError(Exception):
    pass


def require(condition, message):
    if not condition:
        raise BackupError(message)


def offline():
    service = subprocess.run(
        ["/usr/bin/systemctl", "show", "--property=ActiveState,Result", "mcbedrock.service"],
        check=True, capture_output=True, text=True,
    )
    process = subprocess.run(
        ["/usr/bin/pgrep", "-u", "mcserver", "-x", "bedrock_server"],
        check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    require({"ActiveState=inactive", "Result=success"}.issubset(service.stdout.splitlines())
            and process.returncode == 1,
            "Minecraft muss fuer eine konsistente Sicherung sauber gestoppt sein")


def inspect_tree(source):
    require(source.is_dir() and not source.is_symlink(), "Quellverzeichnis ungueltig")
    count = 0
    total = 0
    for root, dirs, files in os.walk(source, followlinks=False):
        for name in dirs + files:
            entry = Path(root) / name
            info = entry.lstat()
            require(stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode),
                    "Links und Spezialdateien sind verboten")
            if stat.S_ISREG(info.st_mode):
                require(info.st_nlink == 1, "Hardlinks sind verboten")
                count += 1
                total += info.st_size
                require(count <= MAX_FILES and total <= MAX_BYTES,
                        "Sicherheitslimit ueberschritten")
    return count, total


def check_source():
    require((SERVER / "server.properties").is_file() and not (SERVER / "server.properties").is_symlink(), "server.properties fehlt")
    return inspect_tree(SERVER)


def check_backup_dir():
    require(BACKUPS.is_dir() and not BACKUPS.is_symlink(),
            "Backup-Verzeichnis fehlt oder ist unsicher")
    info = BACKUPS.stat()
    allowed_uids = {0, pwd.getpwnam("mcserver").pw_uid}
    require(info.st_uid in allowed_uids and not (stat.S_IMODE(info.st_mode) & 0o022),
            "Backup-Verzeichnis muss root oder mcserver gehoeren und darf nicht gruppen-/weltbeschreibbar sein")


def digest(path):
    sha = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            sha.update(chunk)
    return sha.hexdigest()


def validate_archive(path):
    require(path.is_file() and not path.is_symlink(), "Archiv fehlt oder ist ein Symlink")
    count = 0
    with tarfile.open(path, "r:gz") as archive:
        for item in archive:
            require(item.isfile() or item.isdir(), "Unerlaubter Archiv-Eintrag")
            parts = Path(item.name).parts
            require(bool(parts) and parts[0] == SERVER.name and
                    all(part not in ("..", ".") for part in parts) and
                    not item.name.startswith("/"), "Unsicherer Archivpfad")
            if item.isfile():
                count += 1
                require(count <= MAX_FILES and item.size <= MAX_BYTES,
                        "Archiv-Limit ueberschritten")
                stream = archive.extractfile(item)
                require(stream is not None, "Archiv-Eintrag unlesbar")
                while stream.read(1024 * 1024):
                    pass
    return count


def create(directory=None):
    offline()
    check_backup_dir()
    files, source_bytes = check_source()
    directory = BACKUPS if directory is None else directory
    usage = os.statvfs(directory)
    free = usage.f_bavail * usage.f_frsize
    require(free >= source_bytes + max(256 * 1024 ** 2, source_bytes // 10),
            "Nicht genug freier Speicher fuer die Sicherung")
    name = "minecraft-" + time.strftime("%Y%m%d-%H%M%S", time.gmtime()) + "-" + uuid.uuid4().hex[:8] + ".tar.gz"
    target = directory / name
    temp = None
    manifest_temp = None
    try:
        fd, temp_name = tempfile.mkstemp(prefix=".dracorock-", suffix=".part", dir=directory)
        temp = Path(temp_name)
        with os.fdopen(fd, "wb") as output:
            with tarfile.open(fileobj=output, mode="w:gz", dereference=False) as archive:
                archive.add(SERVER, arcname=SERVER.name, recursive=True)
            output.flush()
            os.fsync(output.fileno())
        offline()
        require(validate_archive(temp) == files, "Dateianzahl im Archiv stimmt nicht")
        sha = digest(temp)
        meta = {"schema": 1, "archive": name, "sha256": sha,
                "size": temp.stat().st_size, "files": files,
                "created_utc": int(time.time()), "source_bytes": source_bytes}
        fd, meta_name = tempfile.mkstemp(prefix=".dracorock-", suffix=".json.part", dir=directory)
        manifest_temp = Path(meta_name)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(meta, output, sort_keys=True)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temp, 0o640)
        os.chmod(manifest_temp, 0o640)
        # Publish the data first; if interrupted, an orphan archive is never
        # treated as verified because its sidecar is absent.
        os.replace(temp, target)
        temp = None
        os.replace(manifest_temp, directory / (name + ".json"))
        manifest_temp = None
        sync_directory(directory)
        return meta
    finally:
        if temp is not None:
            temp.unlink(missing_ok=True)
        if manifest_temp is not None:
            manifest_temp.unlink(missing_ok=True)


def sync_directory(directory):
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def managed_directory(directory):
    directory.mkdir(mode=0o700, exist_ok=True)
    info = directory.lstat()
    require(stat.S_ISDIR(info.st_mode) and info.st_uid == 0
            and stat.S_IMODE(info.st_mode) == 0o700, "Unsicheres Aufbewahrungsverzeichnis")
    return directory


def worlds():
    directory = SERVER / "worlds"
    if not directory.exists() and not directory.is_symlink():
        return []
    require(directory.is_dir() and not directory.is_symlink(), "Unsicheres Weltverzeichnis")
    return sorted(entry for entry in directory.iterdir() if not entry.name.startswith(".")
                  and entry.is_dir() and not entry.is_symlink()
                  and (entry / "level.dat").is_file() and not (entry / "level.dat").is_symlink())


def world_zip(source, directory):
    count, size = inspect_tree(source)
    name_file = source / "levelname.txt"
    display_name = source.name
    if name_file.is_file():
        with name_file.open("r", encoding="utf-8-sig", errors="replace") as stream:
            display_name = stream.read(256).strip() or display_name
    label = re.sub(r'[^\w .-]', "_", display_name).strip(" .")[:48] or "Welt"
    stamp = datetime.now(ZONE).strftime("%Y-%m-%dT%H%M%S%z")
    target = directory / f"{label}-{stamp}-{uuid.uuid4().hex[:8]}.zip"
    usage = os.statvfs(directory)
    require(usage.f_bavail * usage.f_frsize >= size + max(256 * 1024 ** 2, size // 10),
            "Nicht genug freier Speicher fuer das Welt-ZIP")
    with tempfile.NamedTemporaryFile(prefix=".world-", suffix=".part", dir=directory, delete=False) as stream:
        stage = Path(stream.name)
        try:
            with ZipFile(stream, "w", compression=ZIP_DEFLATED, compresslevel=3) as archive:
                for path in sorted(source.rglob("*")):
                    archive.write(path, path.relative_to(source).as_posix())
            stream.flush()
            os.fsync(stream.fileno())
            offline()
            with ZipFile(stage) as archive:
                require(sum(not item.is_dir() for item in archive.infolist()) == count
                        and archive.testzip() is None, "Welt-ZIP ist unvollstaendig oder beschaedigt")
            os.replace(stage, target)
            sync_directory(directory)
        finally:
            stage.unlink(missing_ok=True)
    return target


def retained(snapshots):
    """Keep the newest snapshot in each of the latest populated calendar buckets."""
    buckets = ({}, {}, {})
    for path, moment in sorted(snapshots, key=lambda entry: entry[1], reverse=True):
        local = moment.astimezone(ZONE)
        iso = local.isocalendar()
        for bucket, key in zip(buckets, (local.date(), (iso.year, iso.week), (local.year, local.month))):
            bucket.setdefault(key, path)
    return {path for bucket, limit in zip(buckets, (7, 4, 12))
            for path in list(bucket.values())[:limit]}


def prune(directory, full=False):
    snapshots = []
    for path in sorted(directory.iterdir()):
        match = NAME_RE.fullmatch(path.name) if full else WORLD_STAMP.search(path.name)
        if match is None or path.is_symlink() or not path.is_file():
            continue
        try:
            if full:
                sidecar = path.with_name(path.name + ".json")
                if sidecar.is_symlink() or not sidecar.is_file():
                    continue
                manifest = json.loads(sidecar.read_text(encoding="utf-8"))
                if manifest["archive"] != path.name or manifest["size"] != path.stat().st_size:
                    continue
                moment = datetime.fromtimestamp(manifest["created_utc"], ZONE)
            else:
                moment = datetime.strptime(match[1], "%Y-%m-%dT%H%M%S%z")
        except (ValueError, KeyError, TypeError, OverflowError):
            continue
        snapshots.append((path, moment))
    keep = retained(snapshots)
    for path, _ in snapshots:
        if path not in keep:
            path.unlink()
            if full:
                path.with_name(path.name + ".json").unlink()
    sync_directory(directory)


def world_directory(source):
    # Use the folder identity as the retention key, even when display names match.
    key = hashlib.sha256(os.fsencode(source.name)).hexdigest()[:24]
    return managed_directory(managed_directory(BACKUPS / "worlds-7-4-12") / key)


def create_set(selected=None):
    offline()
    check_backup_dir()
    sources = worlds()
    if selected is not None:
        sources = [source for source in sources if source.name == selected]
        require(len(sources) == 1, "Welt nicht gefunden")
    destinations = []
    full = None
    if selected is None:
        directory = managed_directory(BACKUPS / "server-7-4-12")
        full = create(directory)
        destinations.append((directory, True))
    archives = []
    for source in sources:
        directory = world_directory(source)
        archives.append(str(world_zip(source, directory)))
        destinations.append((directory, False))
    if selected is None:
        # A removed world still has its own retained history.
        root = BACKUPS / "worlds-7-4-12"
        if root.exists():
            destinations.extend((entry, False) for entry in sorted(managed_directory(root).iterdir())
                                if re.fullmatch(r"[a-f0-9]{24}", entry.name)
                                and (entry, False) not in destinations)
    for directory, is_full in destinations:
        prune(managed_directory(directory), full=is_full)
    return {"ok": True, "server": full, "worlds": archives}


def verify(name):
    require(NAME_RE.fullmatch(name) is not None, "Ungueltiger Archivname")
    check_backup_dir()
    archive = BACKUPS / name
    if not archive.exists() and not archive.is_symlink():
        directory = BACKUPS / "server-7-4-12"
        require(directory.is_dir() and not directory.is_symlink(), "Archiv fehlt")
        archive = directory / name
    sidecar = archive.with_name(name + ".json")
    require(sidecar.is_file() and not sidecar.is_symlink(), "Pruefmanifest fehlt")
    meta = json.loads(sidecar.read_text(encoding="utf-8"))
    require(meta.get("schema") == 1 and meta.get("archive") == name,
            "Manifest passt nicht zum Archiv")
    require(archive.is_file() and not archive.is_symlink(), "Archiv fehlt")
    require(archive.stat().st_size == meta.get("size"), "Archivgroesse stimmt nicht")
    require(digest(archive) == meta.get("sha256"), "SHA-256-Pruefung fehlgeschlagen")
    require(validate_archive(archive) == meta.get("files"), "Archivdateien stimmen nicht")
    return {"ok": True, "archive": name, "sha256": meta["sha256"]}


def visit_backups(visit):
    check_backup_dir()

    def scan(directory, scope, pattern, parent, prefix, worlds=False):
        try:
            fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        except (FileNotFoundError, NotADirectoryError):
            return
        try:
            with os.scandir(fd) as entries:
                for entry in entries:
                    relative = prefix + entry.name
                    if worlds:
                        if re.fullmatch(r"[a-f0-9]{24}", entry.name):
                            scan(entry.name, scope, WORLD_STAMP.search, fd, relative + "/")
                        continue
                    if not pattern(entry.name):
                        continue
                    try:
                        info = entry.stat(follow_symlinks=False)
                    except FileNotFoundError:
                        continue
                    if stat.S_ISREG(info.st_mode):
                        visit(scope, entry.name, info, fd, hashlib.sha256(os.fsencode(relative) + f"\0{info.st_dev}:{info.st_ino}:{info.st_mtime_ns}".encode()).hexdigest())
        finally:
            os.close(fd)

    root = os.open(BACKUPS, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        server = re.compile(r"minecraft-.*\.tar\.gz\Z").fullmatch
        scan(".", "server", server, root, "")
        scan("server-7-4-12", "server", server, root, "server-7-4-12/")
        scan("worlds", "worlds", re.compile(r".+\.tar\.gz\Z").fullmatch, root, "worlds/")
        scan("worlds-7-4-12", "worlds", None, root, "worlds-7-4-12/", worlds=True)
    finally:
        os.close(root)


def list_backups():
    files = {"worlds": [], "server": []}
    total_bytes = 0

    def add(scope, name, info, fd, archive_id):
        nonlocal total_bytes
        total_bytes += info.st_size
        if scope == "server":
            try:
                manifest = os.stat(name + ".json", dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                pass
            else:
                if stat.S_ISREG(manifest.st_mode):
                    total_bytes += manifest.st_size
        files[scope].append((info.st_mtime_ns, {
            "id": archive_id,
            "name": name,
            "size": info.st_size,
            "date": datetime.fromtimestamp(info.st_mtime, ZONE).strftime("%Y-%m-%d %H:%M:%S"),
        }))

    visit_backups(add)
    result = {scope: [entry for _, entry in sorted(rows, key=lambda item: (-item[0], item[1]["name"]))]
              for scope, rows in files.items()}
    return {**result, "total_bytes": total_bytes}


def archive_to_zip(source, target, scope, max_output):
    seen = set()
    total = 0
    with tarfile.open(fileobj=source, mode="r|gz") as archive:
        with ZipFile(target, "w", compression=ZIP_DEFLATED, compresslevel=3) as result:
            for item in archive:
                name = item.name.rstrip("/")
                parts = name.split("/")
                require(name and not any(part in ("", ".", "..") or re.search(r'[\\:\x00-\x1f]', part)
                                         for part in parts), "Unsicherer Archivpfad")
                require(scope != "server" or parts[0] == SERVER.name, "Unerwartete Archivwurzel")
                require(item.isfile() or item.isdir(), "Unerlaubter Archiv-Eintrag")
                if scope == "worlds":
                    if len(parts) == 1:
                        require(item.isdir(), "Weltarchiv ohne Weltordner")
                        continue
                    name = "/".join(parts[1:])
                require(name not in seen and len(seen) < MAX_FILES, "Archiv-Limit ueberschritten")
                seen.add(name)
                if item.isdir():
                    result.writestr(name + "/", b"")
                    continue
                total += item.size
                require(total <= MAX_BYTES, "Archiv-Limit ueberschritten")
                stream = archive.extractfile(item)
                require(stream is not None, "Archiv-Eintrag unlesbar")
                with stream, result.open(name, "w", force_zip64=True) as output:
                    while chunk := stream.read(1024 * 1024):
                        output.write(chunk)
                        require(target.tell() <= max_output, "Nicht genug Platz fuer den ZIP-Download")
    require(bool(seen) and target.tell() <= max_output, "ZIP-Export unvollstaendig")


def open_backup(archive_id):
    require(re.fullmatch(r"[a-f0-9]{64}", archive_id) is not None, "Ungueltige Backup-ID")
    selected = None

    def select(scope, name, info, fd, candidate_id):
        nonlocal selected
        if candidate_id != archive_id:
            return
        handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        current = os.fstat(handle)
        if (not stat.S_ISREG(current.st_mode) or current.st_nlink != 1
                or (current.st_dev, current.st_ino) != (info.st_dev, info.st_ino)):
            os.close(handle)
            raise BackupError("Archiv wurde veraendert")
        selected = scope, name, os.fdopen(handle, "rb")

    visit_backups(select)
    require(selected is not None, "Backup nicht gefunden")
    return selected


def download_backup(archive_id):
    scope, name, source = open_backup(archive_id)
    with source:
        if name.endswith(".zip"):
            send_zip(source, name)
            return
        # Only one conversion uses scratch space at a time.
        lock = LOCK.with_name("dracorock-backup-download.lock")
        with lock.open("a") as guard:
            try:
                fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as exc:
                raise BackupError("Ein ZIP-Export laeuft bereits") from exc
            usage = os.statvfs(LOCK.parent)
            max_output = usage.f_bavail * usage.f_frsize - 256 * 1024 ** 2
            require(max_output > 0, "Nicht genug Platz fuer den ZIP-Download")
            with tempfile.TemporaryFile(dir=LOCK.parent) as output:
                archive_to_zip(source, output, scope, max_output)
                output.seek(0)
                send_zip(output, name.removesuffix(".tar.gz") + ".zip")


def send_zip(source, name):
    size = os.fstat(source.fileno()).st_size
    print(json.dumps({"name": name, "size": size}, ensure_ascii=True), flush=True)
    shutil.copyfileobj(source, sys.stdout.buffer, 1024 * 1024)


def delete_backup(archive_id):
    require(re.fullmatch(r"[a-f0-9]{64}", archive_id) is not None, "Ungueltige Backup-ID")
    deleted = False

    def remove(scope, name, info, fd, candidate_id):
        nonlocal deleted
        if archive_id != candidate_id:
            return
        current = os.stat(name, dir_fd=fd, follow_symlinks=False)
        require(stat.S_ISREG(current.st_mode) and (current.st_dev, current.st_ino)
                == (info.st_dev, info.st_ino), "Archiv wurde veraendert")
        os.unlink(name, dir_fd=fd)
        if scope == "server":
            manifest = name + ".json"
            try:
                info = os.stat(manifest, dir_fd=fd, follow_symlinks=False)
                if stat.S_ISREG(info.st_mode):
                    os.unlink(manifest, dir_fd=fd)
            except FileNotFoundError:
                pass
        os.fsync(fd)
        deleted = True

    visit_backups(remove)
    require(deleted, "Backup nicht gefunden")
    return {"ok": True}


@contextlib.contextmanager
def world_archive(archive_id):
    scope, name, source = open_backup(archive_id)
    with source, contextlib.ExitStack() as stack:
        require(scope == "worlds", "Bitte ein Weltbackup auswählen")
        if not name.endswith(".zip"):
            converted = stack.enter_context(tempfile.TemporaryFile(dir=LOCK.parent))
            archive_to_zip(source, converted, scope, shutil.disk_usage(LOCK.parent).free // 2)
            converted.seek(0)
            source = converted
        archive = stack.enter_context(ZipFile(source))
        yield name, archive


def inspect_world_archive(archive):
    seen = set()
    total = 0
    for item in archive.infolist():
        name = item.filename.rstrip("/")
        parts = name.split("/")
        mode = item.external_attr >> 16
        require(name and all(part not in ("", ".", "..") for part in parts)
                and not re.search(r'[\\:\x00-\x1f]', name), "Unsicherer Archivpfad")
        require(name not in seen and len(seen) < MAX_FILES, "Doppelte Pfade oder zu viele Dateien")
        require(not stat.S_ISLNK(mode) and (stat.S_IFMT(mode) in (0, stat.S_IFREG, stat.S_IFDIR))
                and not item.flag_bits & 1, "Links, Spezialdateien und verschlüsselte Archive sind verboten")
        seen.add(name)
        total += item.file_size
        require(total <= MAX_BYTES, "Weltarchiv ist zu groß")
    require("level.dat" in seen and not archive.getinfo("level.dat").is_dir()
            and any(item.filename.startswith("db/") and not item.is_dir() for item in archive.infolist()),
            "Weltbackup benötigt level.dat und eine db-Datenbank")
    return {"files": len(seen), "bytes": total}


def restore_preview(request):
    require(isinstance(request, dict) and isinstance(request.get("id"), str), "Ungültige Backup-Auswahl")
    with world_archive(request["id"]) as (name, archive):
        details = inspect_world_archive(archive)
    return {"ok": True, "id": request["id"], "name": name, **details,
            "targets": [source.name for source in worlds()]}


def restore_world(request):
    require(isinstance(request, dict) and isinstance(request.get("id"), str), "Ungültige Backup-Auswahl")
    target_name = request.get("target")
    require(isinstance(target_name, str) and 1 <= len(target_name) <= 80
            and target_name == target_name.strip() and target_name not in (".", "..")
            and not re.search(r'[/\\:\x00-\x1f]', target_name), "Ungültige Zielwelt")
    target = SERVER / "worlds" / target_name
    require(target in worlds(), "Die ausgewählte Zielwelt existiert nicht")
    offline()
    original = target.stat()
    with world_archive(request["id"]) as (_, archive):
        details = inspect_world_archive(archive)
        _, current_size = inspect_tree(target)
        require(shutil.disk_usage(target.parent).free >= details["bytes"] + current_size + 256 * 1024 ** 2,
                "Nicht genug Speicher für Wiederherstellung und Sicherung")
        with tempfile.TemporaryDirectory(prefix=".dracorock-restore-", dir=target.parent) as directory:
            stage = Path(directory) / "world"
            stage.mkdir()
            for item in archive.infolist():
                destination = stage / item.filename
                if item.is_dir():
                    destination.mkdir(parents=True, exist_ok=True)
                    continue
                destination.parent.mkdir(parents=True, exist_ok=True)
                with archive.open(item) as source, destination.open("xb") as output:
                    shutil.copyfileobj(source, output, 1024 * 1024)
                    output.flush()
                    os.fsync(output.fileno())
            inspect_tree(stage)
            account = pwd.getpwnam("mcserver")
            for entry in [stage, *stage.rglob("*")]:
                os.chown(entry, account.pw_uid, account.pw_gid)
                os.chmod(entry, 0o750 if entry.is_dir() else 0o640)
                if entry.is_dir():
                    sync_directory(entry)
            snapshot = world_zip(target, world_directory(target))
            offline()
            current = target.lstat()
            require(stat.S_ISDIR(current.st_mode) and
                    (current.st_dev, current.st_ino) == (original.st_dev, original.st_ino),
                    "Zielwelt wurde inzwischen verändert")
            # Linux renameat2 exchanges both directories in one atomic operation.
            libc = ctypes.CDLL(None, use_errno=True)
            exchange = libc.renameat2
            exchange.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
            exchange.restype = ctypes.c_int
            if exchange(-100, os.fsencode(stage), -100, os.fsencode(target), 2) != 0:
                raise OSError(ctypes.get_errno(), "Atomarer Weltwechsel fehlgeschlagen")
            sync_directory(target.parent)
            sync_directory(stage.parent)
    return {"ok": True, "target": target_name, "safety_backup": snapshot.name}


MAINTENANCE = Path("/var/lib/bedrock-control-pro/maintenance")
JOBS = Path("/var/lib/bedrock-control-pro/jobs")
RUNTIME_JOBS = Path("/run/bedrock-panel-jobs")
SCHEDULE_CONFIG = Path("/etc/bedrock-control-pro/backup-schedule.json")
TIMER_OVERRIDE = Path("/etc/systemd/system/dracorock-backup.timer.d/schedule.conf")


def schedule_config():
    defaults = {"enabled": True, "time": "04:00", "days": list(range(7)), "retry_minutes": 120}
    return validate_schedule(read_record(SCHEDULE_CONFIG) if SCHEDULE_CONFIG.exists() else defaults)


def validate_schedule(data):
    require(isinstance(data, dict) and set(data) == {"enabled", "time", "days", "retry_minutes"},
            "Ungültiger Backup-Zeitplan")
    require(type(data["enabled"]) is bool and isinstance(data["time"], str)
            and re.fullmatch(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]", data["time"]),
            "Uhrzeit muss HH:MM sein")
    require(isinstance(data["days"], list) and 1 <= len(data["days"]) <= 7
            and all(type(day) is int and 0 <= day <= 6 for day in data["days"])
            and len(set(data["days"])) == len(data["days"]), "Wochentage sind ungültig")
    require(type(data["retry_minutes"]) is int and 0 <= data["retry_minutes"] <= 120,
            "Wiederholungsfenster muss zwischen 0 und 120 Minuten liegen")
    return {**data, "days": sorted(data["days"])}


def atomic_text(path, text, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        fd, name = tempfile.mkstemp(prefix=".dracorock-", dir=path.parent)
        temporary = Path(name)
        with os.fdopen(fd, "w") as output:
            output.write(text)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def save_schedule(data):
    settings = validate_schedule(data)
    MAINTENANCE.mkdir(mode=0o755, parents=True, exist_ok=True)
    with (MAINTENANCE / "settings.lock").open("a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
        old_config = SCHEDULE_CONFIG.read_bytes() if SCHEDULE_CONFIG.exists() else None
        old_override = TIMER_OVERRIDE.read_bytes() if TIMER_OVERRIDE.exists() else None
        was_enabled = command("/usr/bin/systemctl", "is-enabled", "dracorock-backup.timer").returncode == 0
        was_active = command("/usr/bin/systemctl", "is-active", "dracorock-backup.timer").returncode == 0
        weekdays = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
        calendar = ",".join(weekdays[day] for day in settings["days"])
        override = "[Timer]\nOnCalendar=\n"
        override += f"OnCalendar={calendar} *-*-* {settings['time']}:00 Europe/Berlin\n"
        try:
            atomic_text(SCHEDULE_CONFIG, json.dumps(settings))
            atomic_text(TIMER_OVERRIDE, override, 0o644)
            actions = [("daemon-reload",),
                       ("enable" if settings["enabled"] else "disable", "--now", "dracorock-backup.timer")]
            if settings["enabled"]:
                actions.append(("restart", "dracorock-backup.timer"))
            for args in actions:
                require(command("/usr/bin/systemctl", *args).returncode == 0,
                        "Backup-Timer konnte nicht aktualisiert werden")
        except BaseException:
            for path, previous in ((SCHEDULE_CONFIG, old_config), (TIMER_OVERRIDE, old_override)):
                if previous is None:
                    path.unlink(missing_ok=True)
                else:
                    atomic_text(path, previous.decode(), 0o644 if path == TIMER_OVERRIDE else 0o600)
            command("/usr/bin/systemctl", "daemon-reload")
            command("/usr/bin/systemctl", "enable" if was_enabled else "disable", "dracorock-backup.timer")
            command("/usr/bin/systemctl", "restart" if was_active else "stop", "dracorock-backup.timer")
            raise
    return {"ok": True, "settings": settings}


def command(*arguments):
    try:
        return subprocess.run(arguments, capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(arguments, 124, "", "Zeitlimit überschritten")


def read_record(path):
    try:
        record = json.loads(path.read_text())
        return record if isinstance(record, dict) else {}
    except (OSError, ValueError):
        return {}


def write_schedule(state, message, **fields):
    MAINTENANCE.mkdir(mode=0o755, parents=True, exist_ok=True)
    record = {"state": state, "message": message, "updated_at": int(time.time()), **fields}
    with tempfile.NamedTemporaryFile(mode="w", dir=MAINTENANCE, delete=False) as output:
        json.dump(record, output)
        temporary = output.name
    os.replace(temporary, MAINTENANCE / "schedule.json")
    print(json.dumps(record), flush=True)


def history():
    records = {}
    for directory in (JOBS, RUNTIME_JOBS):
        if not directory.is_dir():
            continue
        for path in directory.glob("*.json"):
            if not re.fullmatch(r"[a-f0-9]{32}", path.stem):
                continue
            record = read_record(path)
            if record.get("id") != path.stem or record.get("action") not in (
                    "backup", "update", "start", "stop", "restart", "restore-world"):
                continue
            record.setdefault("updated_at", int(path.stat().st_mtime))
            records[path.stem] = record
    return sorted(records.values(), key=lambda item: item["updated_at"], reverse=True)[:50]


def maintenance_status():
    settings = schedule_config()
    jobs = history()
    successful = [job for job in jobs if job["action"] == "backup" and job.get("state") == "success"]
    latest = read_record(JOBS.parent / "last-backup.json")
    if latest.get("state") == "success" and latest.get("action") == "backup":
        successful.append(latest)
        successful.sort(key=lambda job: job["updated_at"], reverse=True)
    timer = command("/usr/bin/systemctl", "show", "dracorock-backup.timer",
                    "--property=ActiveState,NextElapseUSecRealtime", "--no-pager")
    checks = []
    for filename in ("server.properties", ".installed-bedrock-version"):
        result = command("/usr/sbin/runuser", "-u", "www-data", "--", "/usr/bin/test",
                         "-r", str(SERVER / filename))
        checks.append({"name": filename, "ok": result.returncode == 0,
                       "message": "Lesbar" if result.returncode == 0 else "Webserver kann die Datei nicht lesen"})
    for unit in ("mcbedrock.service", "bedrock-monitor.timer", "dracorock-backup.timer"):
        if unit == "dracorock-backup.timer" and not settings["enabled"]:
            checks.append({"name": unit, "ok": True, "message": "Geplante Backups sind deaktiviert."})
            continue
        result = command("/usr/bin/systemctl", "is-active", unit)
        checks.append({"name": unit, "ok": result.returncode == 0,
                       "message": result.stdout.strip() or "Unbekannt"})
    usage = shutil.disk_usage(SERVER if SERVER.exists() else "/")
    checks.append({"name": "Freier Speicher", "ok": usage.free >= 1024 ** 3,
                   "message": f"{usage.free / 1024 ** 3:.1f} GiB verfügbar"})
    schedule = read_record(MAINTENANCE / "schedule.json")
    if schedule.get("state") in ("running", "waiting"):
        service = command("/usr/bin/systemctl", "is-active", "dracorock-backup.service")
        if service.stdout.strip() not in ("active", "activating"):
            schedule = {**schedule, "state": "interrupted",
                        "message": "Der geplante Lauf wurde unterbrochen. Auftragsverlauf prüfen."}
    return {"ok": True, "schedule": schedule, "settings": settings,
            "timer": dict(line.split("=", 1) for line in timer.stdout.splitlines() if "=" in line),
            "last_success": successful[0] if successful else None, "jobs": jobs, "checks": checks}


def scheduled_backup():
    """Retry admission for two hours, then monitor the one admitted backup."""
    MAINTENANCE.mkdir(mode=0o755, parents=True, exist_ok=True)
    with (MAINTENANCE / "schedule.lock").open("a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
        settings = schedule_config()
        deadline = time.monotonic() + settings["retry_minutes"] * 60
        first = True
        while first or time.monotonic() < deadline:
            first = False
            if not schedule_config()["enabled"]:
                write_schedule("skipped", "Geplante Backups sind deaktiviert.")
                return
            query = command("/usr/local/sbin/bedrock-console-manager", "online")
            try:
                roster = json.loads(query.stdout)
            except ValueError:
                roster = {}
            if not isinstance(roster, dict):
                roster = {}
            empty = (query.returncode == 0 and roster.get("ok") is True
                     and type(roster.get("count")) is int and roster["count"] == 0)
            if empty:
                queued = command("/usr/local/sbin/bedrock-panel-control", "backup")
                match = re.search(r"JOB_ID=([a-f0-9]{32})", queued.stdout)
                if queued.returncode == 0 and match:
                    job_id = match.group(1)
                    write_schedule("running", "Geplantes Backup läuft.", job_id=job_id)
                    # Queue exactly once. A stalled worker must never cause a second backup.
                    for _ in range(600):
                        job = read_record(RUNTIME_JOBS / (job_id + ".json"))
                        if job.get("state") in ("success", "failed"):
                            write_schedule(job["state"], job.get("message", ""), job_id=job_id)
                            return
                        time.sleep(3)
                    write_schedule("failed", "Auftrag nach 30 Minuten noch ohne Abschluss. Auftragsverlauf prüfen.", job_id=job_id)
                    return
                reason = "Ein anderer Steuerauftrag läuft oder die Backup-Annahme ist fehlgeschlagen."
            elif query.returncode == 0 and type(roster.get("count")) is int and roster["count"] > 0:
                reason = "Spieler sind online."
            else:
                reason = "Die Spielerabfrage ist vorübergehend nicht verfügbar."
            if time.monotonic() >= deadline:
                break
            write_schedule("waiting", reason + " Nächster Versuch in fünf Minuten.",
                           retry_at=int(time.time()) + 300)
            time.sleep(min(300, max(0, deadline - time.monotonic())))
        write_schedule("skipped", "Das Wiederholungsfenster ist abgelaufen. Es wurde kein Backup gestartet.")


def main():
    parser = argparse.ArgumentParser(description="DracoRock Backup-Engine")
    parser.add_argument("command", choices=("create", "world", "verify", "preflight", "list", "download", "delete", "status", "scheduled", "schedule-save", "restore-preview", "restore-world"))
    parser.add_argument("archive", nargs="?")
    args = parser.parse_args()
    require(os.geteuid() == 0, "Nur als root ausfuehrbar")
    require((args.command in ("verify", "world")) == (args.archive is not None),
            "verify und world benoetigen genau einen Namen")
    if args.command == "status":
        print(json.dumps(maintenance_status(), ensure_ascii=False))
        return
    if args.command == "scheduled":
        scheduled_backup()
        return
    if args.command == "schedule-save":
        print(json.dumps(save_schedule(json.loads(sys.stdin.read(2048)))))
        return
    if args.command == "download":
        download_backup(sys.stdin.readline(66).rstrip("\n"))
        return
    if args.command == "list":
        print(json.dumps(list_backups(), ensure_ascii=True))
        return
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise BackupError("Ein Backup-Auftrag laeuft bereits") from exc
        if args.command in ("restore-preview", "restore-world"):
            request = json.loads(sys.stdin.read(2048))
            result = restore_preview(request) if args.command == "restore-preview" else restore_world(request)
        elif args.command == "delete":
            result = delete_backup(sys.stdin.readline(66).rstrip("\n"))
        elif args.command == "preflight":
            check_backup_dir()
            files, size = check_source()
            size += sum(inspect_tree(source)[1] for source in worlds())
            statvfs = os.statvfs(BACKUPS)
            require(statvfs.f_bavail * statvfs.f_frsize >= size + max(256 * 1024 ** 2, size // 10),
                    "Nicht genug freier Speicher fuer die Sicherung")
            result = {"ok": True, "files": files, "source_bytes": size}
        else:
            result = verify(args.archive) if args.command == "verify" else create_set(args.archive)
        print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (BackupError, OSError, ValueError, tarfile.TarError, BadZipFile, subprocess.SubprocessError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
        raise SystemExit(1)
