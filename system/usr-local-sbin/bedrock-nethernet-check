#!/usr/bin/env bash
set -Eeuo pipefail
[[ $# -eq 0 || ( $# -eq 1 && "$1" == --wait-port ) ]] || { echo 'Aufruf: bedrock-nethernet-check [--wait-port]' >&2; exit 2; }
PROPERTIES=/home/mcserver/minecraft_bedrock/server.properties
STOP=/home/mcserver/minecraft_bedrock/stop_server.sh
if [[ ! -f "$PROPERTIES" || ! -r "$PROPERTIES" ]]; then
  echo "[NetherNet] FEHLER: server.properties fehlt oder ist nicht lesbar: $PROPERTIES" >&2
  exit 1
fi
PORT="$(awk -F= '/^[[:space:]]*server-port[[:space:]]*=/ {p=$2; sub(/[[:space:]#;].*$/, "", p); gsub(/[[:space:]]/, "", p)} END {print p}' "$PROPERTIES")"
if [[ ! "$PORT" =~ ^[0-9]+$ ]] || ((10#$PORT < 1 || 10#$PORT > 65535)); then
  echo '[NetherNet] FEHLER: server-port fehlt oder ist ungültig.' >&2
  exit 1
fi
PORT=$((10#$PORT))
if [[ "${1:-}" == --wait-port ]]; then
  # Keep the pre-start probe in an existing allowlisted helper so older
  # installed updaters can accept this release without a trust bootstrap.
  exec /usr/bin/python3 - "$PORT" <<'PY_WAIT_PORT'
import errno
import socket
import sys
import time

port = int(sys.argv[1])
deadline = time.monotonic() + 75
waiting = False
while True:
    try:
        # Do not use SO_REUSEADDR: test the address as Bedrock will bind it.
        with socket.socket(socket.AF_INET6, socket.SOCK_STREAM) as probe:
            probe.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
            probe.bind(('::', port))
        print(f'[NetherNet] TCP-Port {port} ist zum Binden frei.', flush=True)
        break
    except OSError as exc:
        if exc.errno != errno.EADDRINUSE:
            raise
        if not waiting:
            print(f'[NetherNet] Warte auf TCP-Port {port} (Listener/TIME_WAIT, maximal 75s).', flush=True)
            waiting = True
        if time.monotonic() >= deadline:
            raise SystemExit(f'[NetherNet] TCP-Port {port} weiterhin belegt; Start abgebrochen.')
        time.sleep(1)
PY_WAIT_PORT
fi
URL="http://127.0.0.1:${PORT}/v1/join"
echo "[NetherNet] Warte maximal 90s auf Bereitschaft (Port ${PORT}) ..."
SUCCESS_COUNT=0
for ((i=1;i<=90;i++)); do
  HTTP_CODE="$(/usr/bin/curl --silent --output /dev/null --max-time 1 --write-out '%{http_code}' "$URL" || true)"
  if [[ "$HTTP_CODE" == 200 ]]; then
    SUCCESS_COUNT=$((SUCCESS_COUNT+1))
    if ((SUCCESS_COUNT >= 2)); then
      echo "[NetherNet] Bereit! HTTP 200 auf Port ${PORT} bestätigt."
      exit 0
    fi
  else
    SUCCESS_COUNT=0
  fi
  /usr/bin/sleep 1
done
echo "[NetherNet] FEHLER: Port ${PORT} nach 90s nicht bereit." >&2
if [[ -x "$STOP" ]]; then
  echo '[NetherNet] Stoppe Minecraft kontrolliert ...' >&2
  "$STOP" || echo '[NetherNet] WARNUNG: Sauberes Stoppen fehlgeschlagen.' >&2
fi
exit 1
