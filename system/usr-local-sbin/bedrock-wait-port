#!/usr/bin/env python3
"""Wait for the NetherNet TCP bind address, including old TIME_WAIT sockets."""
import errno
import pathlib
import socket
import time

properties = {}
for line in pathlib.Path('/home/mcserver/minecraft_bedrock/server.properties').read_text().splitlines():
    if '=' in line and not line.lstrip().startswith('#'):
        key, value = line.split('=', 1)
        properties[key.strip()] = value.strip()
port = int(properties['server-port'])
if not 1 <= port <= 65535:
    raise ValueError('Invalid server-port')
deadline = time.monotonic() + 75
waiting = False
while True:
    try:
        # Match Bedrock's [::] listener. Deliberately no SO_REUSEADDR:
        # an old TCP connection must not block the next server's bind().
        with socket.socket(socket.AF_INET6, socket.SOCK_STREAM) as probe:
            probe.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
            probe.bind(('::', port))
        print(f'[NetherNet] TCP-Port {port} ist zum Binden frei.', flush=True)
        break
    except OSError as exc:
        if exc.errno != errno.EADDRINUSE:
            raise
        if not waiting:
            print(f'[NetherNet] Warte auf TCP-Port {port} (Listener/TIME_WAIT, maximal 75s).', flush=True)
            waiting = True
        if time.monotonic() >= deadline:
            raise SystemExit(f'[NetherNet] TCP-Port {port} weiterhin belegt; Start abgebrochen.')
        time.sleep(1)
